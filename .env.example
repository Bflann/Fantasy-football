# Required: the number in your league URL (…/football/league?leagueId=123456)
LEAGUE_ID=123456

# Only needed for PRIVATE leagues. Copy from your browser cookies while logged in to ESPN
# (DevTools > Application > Cookies > espn.com). SWID includes the curly braces.
ESPN_S2=
SWID=

# Optional: first season to look at. Defaults to walking back until ESPN has no data.
# START_YEAR=2018
PORT=3000
